msgstr "गाउँघरतिर घुमघाम"

msgid "Couple"
msgstr "जोडी"

msgid "Current choice · Optional maps and videos accepted."
msgstr "हालको रोजाइ · बाह्य नक्सा र भिडियो लोड गर्न अनुमति दिइएको छ।"

msgid "Current choice · Optional maps and videos rejected."
msgstr "हालको रोजाइ · बाह्य नक्सा र भिडियो लोड गर्न अनुमति दिइएको छैन।"

msgid "DAY TRIPS FROM KATHMANDU VALLEY"
msgstr "काठमाडौं उपत्यकाबाट एकदिने घुमघाम"

msgid "DURING THE VISIT"
msgstr "घुम्ने क्रममा"

msgid "Dakshinkali Temple"
msgstr "दक्षिणकाली मन्दिर"

