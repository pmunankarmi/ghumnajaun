msgstr "मेरी शेफर्ड स्लुसरको नेपाल मण्डला"

msgid "Matching destinations"
msgstr "मिल्दो गन्तव्यहरू"

msgid "Matsya Narayan Temple"
msgstr "मत्स्यनारायण मन्दिर"

