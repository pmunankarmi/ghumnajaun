msgstr "अन्तिम अद्यावधिक"

msgid "Leave this field empty"
msgstr "यो ठाउँ खाली छोड्नुहोस्"

msgid "Leave time for the return drive"
msgstr "गाडीमा फर्कन लाग्ने समय राख्नुहोस्"

