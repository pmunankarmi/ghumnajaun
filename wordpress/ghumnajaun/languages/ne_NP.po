msgstr "घुम्ने ठाउँ हेर्नुहोस्"

msgid "Budhanilkantha"
msgstr "बूढानीलकण्ठ"

msgid "Budhanilkantha Temple, Kathmandu"
msgstr "बूढानीलकण्ठ मन्दिर, काठमाडौं"

