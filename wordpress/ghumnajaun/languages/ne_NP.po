msgstr "10 भन्दा कम"

msgid "Update a guide"
msgstr "मार्गदर्शनमा सुधार सुझाउनुहोस्"

msgid "Updates and contact"
msgstr "अद्यावधिक र सम्पर्क"

msgid "Uphill walk with steps"
msgstr "सिँढीसहितको उकालो बाटो"

msgid "Use 100 characters or fewer."
msgstr "100 वा कम अक्षरमा लेख्नुहोस्।"

